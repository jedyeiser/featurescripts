{
  "description": "Claude Code settings for Onshape FeatureScript development",
  "project": {
    "name": "FeatureScript Development",
    "type": "onshape-featurescript"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -File \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\fscheck_hook.ps1\"",
            "timeout": 60,
            "statusMessage": "fscheck..."
          }
        ]
      }
    ]
  }
}
